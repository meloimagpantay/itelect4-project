# Copy this file to .env and fill it in. .env is in .gitignore.
#
# Where the API is. On your laptop that is the Express app from
# Session 9; in Vercel it is the backend's own deployment URL, set in
# Project Settings > Environment Variables instead of in a file.
#
# Vite bakes this into the bundle at build time, so changing it means
# restarting npm run dev, or redeploying.
VITE_API_URL=
